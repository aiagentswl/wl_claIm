# Copy these names into Vercel → Project → Settings → Environment Variables.
# Do NOT put real values in this file — it's just a reference of what's needed.
# (This file is safe to commit; a real ".env" with actual values should never be.)

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional — only set this if you later pay for official X API access
# (see the deploy guide). Leave unset to keep using the free resolver.
X_BEARER_TOKEN=
